# This file is managed by Ansible, all changes will be lost

{# Prepare plugin and theme configuration #}
{% set default_plugin_names = (
  (ohmyzsh_default_plugins | default([])) +
  (item.plugins | default([]))
) | map(attribute='name') | list %}

{% set custom_plugin_names = [] %}
{% for plugin in ohmyzsh_custom_plugins | default([]) %}
{% if plugin.install | default(true) %}
{% set _ = custom_plugin_names.append(plugin.name) %}
{% endif %}
{% endfor %}

{% set selected_theme = item.theme | default(ohmyzsh_default_theme) %}
{% set theme_name = selected_theme.split('/')[0] %}
{% set theme_config = ohmyzsh_themes | default([])
  | selectattr('name', 'equalto', theme_name)
  | list %}
{% set theme_available = (
  theme_config | length == 0 or
  theme_config[0].install | default(false) | bool
) %}

# ------------------------------------------------------------
# Environment and executable paths
# ------------------------------------------------------------

ZSH="{{ ohmyzsh_install_dir }}"

# Keep PATH entries unique
typeset -U path PATH

{% if ansible_system == 'Darwin' %}
# Homebrew binaries and optional package directories
export PATH="{{ ohmyzsh_brew_prefix.stdout }}/bin:{{ ohmyzsh_brew_prefix.stdout }}/sbin:${PATH}"

if [[ -d "{{ ohmyzsh_brew_prefix.stdout }}/opt/libpq/bin" ]]; then
    path=("{{ ohmyzsh_brew_prefix.stdout }}/opt/libpq/bin" "${path[@]}")
fi

if [[ -d "{{ ohmyzsh_brew_prefix.stdout }}/opt/openvpn/sbin" ]]; then
    path=("{{ ohmyzsh_brew_prefix.stdout }}/opt/openvpn/sbin" "${path[@]}")
fi

export ZSH_CACHE_DIR="${HOME}/.ohmyzsh_cache"
{% endif %}

# User-installed executables
export PATH="${PATH}:${HOME}/.krew/bin"
export PATH="${PATH}:${HOME}/.rbenv/bin:${HOME}/.rbenv/shims"
export PATH="${PATH}:${HOME}/.cargo/bin"
export PATH="${PATH}:${HOME}/.local/bin:${HOME}/bin"

# Editor and locale
export EDITOR=vim
export VISUAL=vim
export LC_CTYPE="en_US.UTF-8"
export LANG="en_US.UTF-8"

# Terminal settings
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad

{% if ansible_system == 'Darwin' %}
# XQuartz: preserve DISPLAY when provided by SSH or the terminal
export DISPLAY="${DISPLAY:-:0}"
{% endif %}

# Timezone for SSH sessions
export TZ="{{ control_host_tz }}"

# GPG terminal
if [[ -t 0 ]]; then
  export GPG_TTY="$(tty)"
fi

# ------------------------------------------------------------
# Oh My Zsh settings (must precede initialization)
# ------------------------------------------------------------

# Disable completion permission warnings
ZSH_DISABLE_COMPFIX=true

# Theme selection
ZSH_THEME="{{ selected_theme if theme_available else ohmyzsh_default_theme }}"

# Powerlevel9k configuration
{% if theme_available and theme_name == 'powerlevel9k' %}
[[ -f "{{ ohmyzsh_powerlevel9k_cfg }}" ]] && source "{{ ohmyzsh_powerlevel9k_cfg }}"
{% endif %}

# SSH agent identities
{% if item.ssh_ids | default([]) | length > 0 %}
zstyle :omz:plugins:ssh-agent agent-forwarding on
zstyle :omz:plugins:ssh-agent identities {{ item.ssh_ids | join(' ') }}
{% endif %}

# Enabled plugins
default_plugins=(
{% for plugin in default_plugin_names %}
  {{ plugin }}
{% endfor %}
)

custom_plugins=(
{% for plugin in custom_plugin_names %}
  {{ plugin }}
{% endfor %}
)

# Load additional user plugin configuration if present
if [[ -f "${HOME}/.zsh/plugins" ]]; then
  source "${HOME}/.zsh/plugins"
fi

plugins=( ${default_plugins} ${custom_plugins} )

# Autosuggestions appearance
{% if 'zsh-autosuggestions' in custom_plugin_names %}
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=white'
{% endif %}

{% if ansible_system == 'Darwin' %}
# Homebrew Zsh completions
brew_completions="{{ ohmyzsh_brew_prefix.stdout }}/share/zsh/site-functions"

if [[ -d "${brew_completions}" ]] && (( ${fpath[(Ie)$brew_completions]} == 0 )); then
    fpath=("${brew_completions}" "${fpath[@]}")
fi

unset brew_completions
{% endif %}

{% if ohmyzsh_setup_tmux | default(false) and 'tmux' in default_plugin_names %}
ZSH_TMUX_AUTOSTART=false
{% endif %}

# ------------------------------------------------------------
# Initialize Oh My Zsh
# ------------------------------------------------------------

source "${ZSH}/oh-my-zsh.sh"

# ------------------------------------------------------------
# Theme configuration (after initialization)
# ------------------------------------------------------------

{% if theme_available and theme_name == 'powerlevel10k' and (ohmyzsh_powerlevel10k_import_config | bool) %}
# Load Powerlevel10k configuration
[[ -f "${HOME}/.p10k.zsh" ]] && source "${HOME}/.p10k.zsh"
{% endif %}

# ------------------------------------------------------------
# Custom shell configuration
# ------------------------------------------------------------

# Load custom aliases, functions and configuration
if [[ -d "${HOME}/.zsh/conf.d" ]]; then
  for config in "${HOME}"/.zsh/conf.d/*.zsh(N); do
    [[ -r "$config" ]] && source "$config"
  done
fi

# Rails environment variables
[[ -f "${HOME}/.rails.env" ]] && source "${HOME}/.rails.env"

# fzf configuration
[[ -f "${HOME}/.fzf.zsh" ]] && source "${HOME}/.fzf.zsh"

# ------------------------------------------------------------
# Optional tmux autostart (after shell initialization)
# ------------------------------------------------------------

{% if ohmyzsh_setup_tmux | default(false) %}
# Start tmux for interactive local terminal sessions only
if [[ -z "${TMUX:-}" && -z "${SSH_CONNECTION:-}" && -z "${SSH_CLIENT:-}" && -o interactive && -t 0 && -t 1 ]] && command -v tmux >/dev/null 2>&1; then
    exec tmux
fi
{% endif %}
